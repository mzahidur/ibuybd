{
  "Routes": [
    // ✅ Identity Service (WebAPI)
    {
      "DownstreamPathTemplate": "/api/identity/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "ibuybd-identityservice-1",
          "Port": 80
        }
      ],
      "UpstreamPathTemplate": "/api/identity/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer",
        "AllowedScopes": []
      }
    },

    // ✅ Order Service (WebAPI)
    {
      "DownstreamPathTemplate": "/api/orders/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "ibuybd-orderservice-1",
          "Port": 80
        }
      ],
      "UpstreamPathTemplate": "/api/orders/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ]
    },

    // ✅ Product Service (WebAPI)
    {
      "DownstreamPathTemplate": "/api/products/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "ibuybd-productservice-1",
          "Port": 80
        }
      ],
      "UpstreamPathTemplate": "/api/products/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ]
    },

    // ✅ Shopping Cart Service (WebAPI)
    {
      "DownstreamPathTemplate": "/api/cart/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "ibuybd-shoppingcartservice-1",
          "Port": 80
        }
      ],
      "UpstreamPathTemplate": "/api/cart/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ]
    },

    // ✅ Facebook Marketplace Service (gRPC)
    {
      "DownstreamPathTemplate": "/FBMktService",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "ibuybd-fbmktservice-1",
          "Port": 5003
        }
      ],
      "UpstreamPathTemplate": "/grpc/facebook",
      "UpstreamHttpMethod": [ "POST" ],
      "Grpc": {
        "IsGrpc": true
      }
    },

    // ✅ Inventory Service (gRPC)
    {
      "DownstreamPathTemplate": "/InventoryService",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "ibuybd-inventoryservice-1",
          "Port": 5001
        }
      ],
      "UpstreamPathTemplate": "/grpc/inventory",
      "UpstreamHttpMethod": [ "POST" ],
      "Grpc": {
        "IsGrpc": true
      }
    },

    // ✅ Payment Service (gRPC)
    {
      "DownstreamPathTemplate": "/PaymentService",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "ibuybd-paymentservice-1",
          "Port": 5002
        }
      ],
      "UpstreamPathTemplate": "/grpc/payment",
      "UpstreamHttpMethod": [ "POST" ],
      "Grpc": {
        "IsGrpc": true
      }
    }
  ],

  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:5000",
    "RequestIdKey": "X-Request-ID"
  }
}
